# Copy to .env and fill in values from your PayTR merchant panel.
# Never commit .env or expose these values to browser JavaScript.
PAYTR_MERCHANT_ID=721034
PAYTR_MERCHANT_KEY=EupEc6paUGXBLoU9
PAYTR_MERCHANT_SALT=UuizBK4M5s9aznD1
PAYTR_TEST_MODE=0

# Add this exact HTTPS URL to PayTR Merchant Panel > Notification URL settings:
# https://your-domain.example/api/payments/paytr/notify
# Notifications are verified with the PayTR callback hash before status is stored.
# This callback URL is set in the PayTR merchant panel, not sent as a token field.

# Public origin where this Node app is reachable. Local development default:
APP_BASE_URL=http://localhost:3000
PORT=3000

# Email & Password Reset Service (SMTP / Resend / SendGrid)
# Email & Password Reset Service (SMTP)
SMTP_HOST=mail.bytewavestudio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ledgerly@bytewavestudio.com
SMTP_PASS=PleskteBelirlediginMailSifresi
SMTP_FROM="Ledgerly <ledgerly@bytewavestudio.com>"

# Optional token signing secret (falls back to APP_ENCRYPTION_KEY if empty)
RESET_TOKEN_SECRET=

# Fill both before starting the server. Use a unique username and long random password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Required for private user data encryption. Generate with: openssl rand -base64 32
# Keep this key in a secure backup separate from the encrypted database.
# If the key is lost, encrypted user profiles and trades cannot be recovered.
APP_ENCRYPTION_KEY=

# Optional when running behind a trusted reverse proxy. Keep false otherwise.
TRUST_PROXY=false
